  awayFreeKicksSecondHalf            Int?
  awayGoalKicks                      Int?
  awayGoalKicksFirstHalf             Int?
  awayGoalKicksSecondHalf            Int?
  awayGoalsPrevented                 Float?
  awayHitWoodwork                    Int?
  awayHitWoodworkFirstHalf           Int?
  awayHitWoodworkSecondHalf          Int?
