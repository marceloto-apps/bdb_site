// ===========================================
// BigDataBet — Schema Prisma (Fase 1)
// ===========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ===========================================
// ENUMS
// ===========================================

// Papéis de usuário no sistema
enum Role {
  ADMIN
  EDITOR
  AUTOR
  MEMBRO
}

// Planos de assinatura disponíveis
enum Plan {
  FREE
  VIP_BASICO
  VIP_PRO
}

// Status do workflow de artigos no CMS
enum ArticleStatus {
  RASCUNHO
  REVISAO
  PUBLICADO
}

// Tipos de artigos disponíveis
enum ArticleType {
  ESTUDO
  ANALISE
  ARTIGO
}

// Status da assinatura Stripe
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
  UNPAID
}

// ===========================================
// NEXTAUTH.JS v5 — TABELAS OBRIGATÓRIAS
// ===========================================

// Usuário principal do sistema
model User {
  id              String            @id @default(cuid())
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  image           String?
  role            Role              @default(MEMBRO)
  plan            Plan              @default(FREE)
  password        String?
  newsletterOptIn Boolean           @default(false)
  stripeCustomerId String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  accounts          Account[]
  revisions         ArticleRevision[]
  articles          Article[]         @relation("ArticleAuthor")
  favorites         Favorite[]
  matchImports      MatchImport[]
  readHistory       ReadHistory[]
  sessions          Session[]
  subscription      Subscription?
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  pointTransactions PointTransaction[]
  coupons           Coupon[]
  bolaoPalpites     BolaoPalpite[]
  bolaoScores       BolaoScore[]
  legacyAccess      LegacyAccess?
  lessonComments    LessonComment[]
  savedBacktests    SavedBacktest[]

  @@map("users")
}

// Conta OAuth vinculada (Google, GitHub etc.)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_userId_fkey")
  @@map("accounts")
}

// Sessão ativa do usuário
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_fkey")
  @@map("sessions")
}

// Token de verificação de email / magic link
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===========================================
// STRIPE — ASSINATURA
// ===========================================

// Assinatura Stripe vinculada ao usuário
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model LegacyAccess {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String?  @unique
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("legacy_access")
}

model StripeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  processed Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

// ===========================================
// CMS — ARTIGOS, CATEGORIAS E TAGS
// ===========================================

// Artigo do CMS com workflow de publicação
model Article {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  excerpt     String?           @db.Text
  content     String            @db.LongText
  thumbnail   String?
  type        ArticleType
  status      ArticleStatus     @default(RASCUNHO)
  authorId    String
  categoryId  String?
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  minPlan     Plan              @default(FREE)
  revisions   ArticleRevision[]
  tags        ArticleTag[]
  author      User              @relation("ArticleAuthor", fields: [authorId], references: [id])
  category    Category?         @relation(fields: [categoryId], references: [id])
  favorites   Favorite[]
  readHistory ReadHistory[]

  @@index([status, type])
  @@index([authorId])
  @@index([categoryId])
  @@index([publishedAt])
  @@map("articles")
}

// Categoria de artigos (ex: Futebol, Basquete, Estratégias)
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  articles  Article[]

  @@map("categories")
}

// Tag para artigos (relação many-to-many implícita)
model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  articles  ArticleTag[]

  @@map("tags")
}

// Tabela de junção N:N entre Article e Tag
model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId], map: "article_tags_tagId_fkey")
  @@map("article_tags")
}

// Histórico de revisões de artigos
model ArticleRevision {
  id         String        @id @default(cuid())
  articleId  String
  editorId   String
  fromStatus ArticleStatus
  toStatus   ArticleStatus
  note       String?       @db.Text
  createdAt  DateTime      @default(now())
  article    Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor     User          @relation(fields: [editorId], references: [id])

  @@index([articleId])
  @@index([editorId])
  @@map("article_revisions")
}

// Artigos favoritos do usuário
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId], map: "favorites_articleId_fkey")
  @@map("favorites")
}

// Histórico de leitura do usuário
model ReadHistory {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  readAt    DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, readAt])
  @@index([articleId], map: "read_history_articleId_fkey")
  @@map("read_history")
}

// Planilhas para download/compra
model Spreadsheet {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  league      String
  country     String?
  fileUrl     String
  fileName    String
  fileSize    String?
  isPremium   Boolean  @default(false)
  downloads   Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("spreadsheets")
}

model Competition {
  id              String          @id @default(cuid())
  externalId      String          @unique
  name            String
  country         String
  countryCode     String?
  type            CompetitionType @default(LEAGUE)
  tier            LeagueTier      @default(FREE)
  active          Boolean         @default(true)
  slug            String          @unique
  hasTeamStats    Boolean         @default(false)
  hasPlayerStats  Boolean         @default(false)
  xgAvailable     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  seasons         Season[]
  imports         MatchImport[]
  ingestJobs      IngestJob[]
  leagueSnapshots LeagueSnapshot[]

  @@index([country])
  @@index([type])
}

model Season {
  id              String       @id @default(cuid())
  externalId      String       @unique
  competitionId   String
  year            String
  isCurrent       Boolean      @default(false)
  startDate       DateTime?
  endDate         DateTime?
  lastSyncedAt    DateTime?    @map("lastSyncedAt")
  syncStatus      String?      @map("syncStatus") @db.VarChar(50)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  competition     Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  teamSeasons     TeamSeason[]
  matches         Match[]
  ingestJobs      IngestJob[]
  leagueSnapshots LeagueSnapshot[]

  @@unique([competitionId, year])
  @@index([competitionId])
  @@index([isCurrent])
}



model Team {
  id              String    @id @default(cuid())
  externalId      String    @unique
  name            String
  shortName       String?
  // Revisão humana do nome (bdb_ingest, `identity:names`): quando preenchido, `name` é o nome
  // canônico pt-BR e prevalece sobre `shortName` na exibição (lib/utils/team-name.ts).
  nameReviewedAt  DateTime?
  nameRef         String?   @db.VarChar(200)
  country         String?
  stadiumName     String?
  stadiumCity     String?
  stadiumCapacity Int?
  logoUrl         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  aliases         TeamAlias[]
  teamSeasons     TeamSeason[]

  homeMatches     Match[]     @relation("HomeTeam")
  awayMatches     Match[]     @relation("AwayTeam")
  playerStats     PlayerMatchStats[]
  shots           Shot[]
  matchTeamStats  MatchTeamStats[]

  @@index([country])
  @@map("teams")
}

model TeamAlias {
  id          String     @id @default(cuid())
  teamId      String
  alias       String
  source      DataSource

  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([alias, source])
  @@index([teamId])
  @@index([alias])
}

model TeamSeason {
  id              String   @id @default(cuid())
  teamId          String
  seasonId        String

  matchesPlayed   Int?
  wins            Int?
  draws           Int?
  losses          Int?
  points          Int?
  position        Int?
  goalsFor        Int?
  goalsAgainst    Int?
  goalDifference  Int?
  form            String?

  syncedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season          Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([teamId, seasonId])
  @@index([seasonId])
  @@index([teamId])
  @@index([position])
}



model MatchImport {
  id              String      @id @default(cuid())
  competitionId   String
  seasonId        String?
  importedById    String
  fileName        String?
  syncMode        String?
  rowsProcessed   Int
  rowsCreated     Int
  rowsUpdated     Int
  rowsSkipped     Int
  requestsUsed    Int         @default(0)
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())

  competition     Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  importedBy      User        @relation(fields: [importedById], references: [id])

  @@index([competitionId])
  @@index([importedById])
  @@index([createdAt])
  @@map("match_imports")
}

model ApiQuotaLog {
  id             String   @id @default(cuid())
  endpoint       String
  competitionId  String?
  requestCount   Int      @default(1)
  responseStatus Int?
  source         String   @default("SITE") @db.VarChar(20)
  month          String
  createdAt      DateTime @default(now())

  @@index([month])
  @@index([endpoint, month])
  @@map("api_quota_logs")
}

model Match {
  id              String       @id @default(cuid())
  externalId      String       @unique
  seasonId        String
  homeTeamId      String
  awayTeamId      String
  round           Int?
  status          MatchStatus  @default(SCHEDULED)
  utcDate         DateTime
  fthg            Int?
  ftag            Int?
  ftr             MatchResult?
  hthg            Int?
  htag            Int?
  htr             MatchResult?

  venueName       String?
  venueCity       String?
  refereeName     String?

  xgAvailable     Boolean      @default(false)
  oddsAvailable   Boolean      @default(false)
  liveOddsAvailable Boolean      @default(false)

  dataSource      DataSource   @default(THESTATSAPI)
  sourceFile      String?
  syncedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  season          Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeTeam        Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam        Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  stats           MatchStats?
  odds            MatchOdds[]
  oddsMovements   OddsMovement[]
  playerStats     PlayerMatchStats[]
  shots           Shot[]
  bolaoPalpites   BolaoPalpite[]
  teamStats       MatchTeamStats[]
  leagueSnapshot  LeagueSnapshot?

  @@index([seasonId, utcDate])
  @@index([seasonId, round])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([utcDate])
  @@index([status])
  @@index([dataSource])
  @@map("matches")
}

model MatchStats {
  id                  String   @id @default(cuid())
  matchId             String   @unique

  homeXg              Float?
  awayXg              Float?
  homeXgFirstHalf     Float?
  awayXgFirstHalf     Float?
  homeXgSecondHalf    Float?
  awayXgSecondHalf    Float?

  homePossession      Float?
  awayPossession      Float?

  homeShots           Int?
  awayShots           Int?
  homeShotsOnTarget   Int?
  awayShotsOnTarget   Int?
  homeShotsOffTarget  Int?
  awayShotsOffTarget  Int?
  homeShotsBlocked    Int?
  awayShotsBlocked    Int?

  homeCorners         Int?
  awayCorners         Int?
  homeCrosses         Int?
  awayCrosses         Int?
  homeDribbles        Int?
  awayDribbles        Int?

  homePassesTotal     Int?
  awayPassesTotal     Int?
  homePassesAccurate  Int?
  awayPassesAccurate  Int?

  homeDuelsTotal      Int?
  awayDuelsTotal      Int?
  homeDuelsWon        Int?
  awayDuelsWon        Int?

  homeClearances      Int?
  awayClearances      Int?
  homeInterceptions   Int?
  awayInterceptions   Int?
  homeTackles         Int?
  awayTackles         Int?

  homeSaves           Int?
  awaySaves           Int?

  homeFouls           Int?
  awayFouls           Int?
  homeYellowCards     Int?
  awayYellowCards     Int?
  homeRedCards        Int?
  awayRedCards        Int?
  homeOffsides        Int?
  awayOffsides        Int?

  homeAccurateLongBalls              Int?
  homeAccurateLongBallsFirstHalf     Int?
  homeAccurateLongBallsSecondHalf    Int?
  homeBallRecoveries                 Int?
  homeBallRecoveriesFirstHalf        Int?
  homeBallRecoveriesSecondHalf       Int?
  homeBigChances                     Int?
  homeBigChancesFirstHalf            Int?
  homeBigChancesMissed               Int?
  homeBigChancesMissedFirstHalf      Int?
  homeBigChancesMissedSecondHalf     Int?
  homeBigChancesSecondHalf           Int?
  homeClearancesFirstHalf            Int?
  homeClearancesSecondHalf           Int?
  homeCornersFirstHalf               Int?
  homeCornersSecondHalf              Int?
  homeCrossesFirstHalf               Int?
  homeCrossesSecondHalf              Int?
  homeFinalThirdEntries              Int?
  homeFinalThirdEntriesFirstHalf     Int?
  homeFinalThirdEntriesSecondHalf    Int?
  homeFouledFinalThird               Int?
  homeFouledFinalThirdFirstHalf      Int?
  homeFouledFinalThirdSecondHalf     Int?
  homeFoulsFirstHalf                 Int?
  homeFoulsSecondHalf                Int?
  homeFreeKicks                      Int?
  homeFreeKicksFirstHalf             Int?
  homeFreeKicksSecondHalf            Int?
  homeGoalKicks                      Int?
  homeGoalKicksFirstHalf             Int?
  homeGoalKicksSecondHalf            Int?
  homeGoalsPrevented                 Float?
  homeHitWoodwork                    Int?
  homeHitWoodworkFirstHalf           Int?
  homeHitWoodworkSecondHalf          Int?
  homeInterceptionsFirstHalf         Int?
  homeInterceptionsSecondHalf        Int?
  homeOffsidesFirstHalf              Int?
  homeOffsidesSecondHalf             Int?
  homePassesAccurateFirstHalf        Int?
  homePassesAccurateSecondHalf       Int?
  homePassesTotalFirstHalf           Int?
  homePassesTotalSecondHalf          Int?
  homePossessionFirstHalf            Float?
  homePossessionSecondHalf           Float?
  homeSavesFirstHalf                 Int?
  homeSavesSecondHalf                Int?
  homeShotsBlockedFirstHalf          Int?
  homeShotsBlockedSecondHalf         Int?
  homeShotsFirstHalf                 Int?
  homeShotsInsideBox                 Int?
  homeShotsInsideBoxFirstHalf        Int?
  homeShotsInsideBoxSecondHalf       Int?
  homeShotsOffTargetFirstHalf        Int?
  homeShotsOffTargetSecondHalf       Int?
  homeShotsOnTargetFirstHalf         Int?
  homeShotsOnTargetSecondHalf        Int?
  homeShotsOutsideBox                Int?
  homeShotsOutsideBoxFirstHalf       Int?
  homeShotsOutsideBoxSecondHalf      Int?
  homeShotsSecondHalf                Int?
  homeTacklesFirstHalf               Int?
  homeTacklesSecondHalf              Int?
  homeThrowIns                       Int?
  homeThrowInsFirstHalf              Int?
  homeThrowInsSecondHalf             Int?
  homeTouchesPenaltyArea             Int?
  homeTouchesPenaltyAreaFirstHalf    Int?
  homeTouchesPenaltyAreaSecondHalf   Int?
  homeYellowCardsFirstHalf           Int?
  homeYellowCardsSecondHalf          Int?

  awayAccurateLongBalls              Int?
  awayAccurateLongBallsFirstHalf     Int?
  awayAccurateLongBallsSecondHalf    Int?
  awayBallRecoveries                 Int?
  awayBallRecoveriesFirstHalf        Int?
  awayBallRecoveriesSecondHalf       Int?
  awayBigChances                     Int?
  awayBigChancesFirstHalf            Int?
  awayBigChancesMissed               Int?
  awayBigChancesMissedFirstHalf      Int?
  awayBigChancesMissedSecondHalf     Int?
  awayBigChancesSecondHalf           Int?
  awayClearancesFirstHalf            Int?
  awayClearancesSecondHalf           Int?
  awayCornersFirstHalf               Int?
  awayCornersSecondHalf              Int?
  awayCrossesFirstHalf               Int?
  awayCrossesSecondHalf              Int?
  awayFinalThirdEntries              Int?
  awayFinalThirdEntriesFirstHalf     Int?
  awayFinalThirdEntriesSecondHalf    Int?
