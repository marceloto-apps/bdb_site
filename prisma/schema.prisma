// ============================================
// Fase S — Tabelas para o serviço bdb-ingest
// ============================================

/// Histórico de movimentação de odds
model OddsMovement {
  id           String    @id @default(cuid())
  matchId      String
  match        Match     @relation(fields: [matchId], references: [id])
  bookmakerId  String
  bookmaker    Bookmaker @relation(fields: [bookmakerId], references: [id])
  marketId     String
  market       Market    @relation(fields: [marketId], references: [id])
  selection    String
  line         Float?
  odds         Float
  oddsType     OddsType  @default(PREMATCH_CLOSING)
  capturedAt   DateTime
  milestone    String?   @db.VarChar(20)
  createdAt    DateTime  @default(now())

  @@index([matchId, bookmakerId, marketId, selection])
  @@index([matchId, capturedAt])
  @@index([matchId, bookmakerId, milestone])
  @@map("odds_movements")
}

/// Registro de cada job de ingestão executado
model IngestJob {
  id               String       @id @default(cuid())
  jobType          String       @db.VarChar(50)   // MATCHES | ODDS | STATS | PLAYERS
  competitionId    String?
  competition      Competition? @relation(fields: [competitionId], references: [id])
  seasonId         String?
  season           Season?      @relation(fields: [seasonId], references: [id])
  status           String       @db.VarChar(30)   // PENDING | RUNNING | COMPLETED | FAILED
  matchesProcessed Int          @default(0)
  requestsUsed     Int          @default(0)
  error            String?      @db.Text
  checkpoint       Json?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([jobType, status])
  @@index([competitionId, seasonId])
  @@map("ingest_jobs")
}

// ══════════════════════════════════════════
// CURSOS — Fase 5 (estrutura)
// ══════════════════════════════════════════

enum CourseAccess {
  GRATIS
  INCLUSO_BASICO
  INCLUSO_PRO
  AVULSO
}

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  description      String?      @db.Text
  coverUrl         String?
  access           CourseAccess
  priceCents       Int?         // preço avulso em centavos (apenas se AVULSO)
  pointsUnlockCost Int?         // custo em BDB Points para desbloquear (opcional)
  published        Boolean      @default(false)
  order            Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  modules          Module[]

  @@index([published])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String           @id @default(cuid())
  moduleId    String
  title       String
  order       Int              @default(0)
  videoUrl    String?          // preenchido na Onda C (player)
  coverUrl    String?          // Capa da aula (Cloudinary)
  contentHtml String?          @db.Text
  durationSec Int?
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  quiz        Quiz?
  comments    LessonComment[]

  @@index([moduleId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  watchedPct  Float     @default(0)   // 0 a 100
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model LessonComment {
  id        String          @id @default(cuid())
  lessonId  String
  userId    String
  content   String          @db.Text
  parentId  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  lesson    Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    LessonComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   LessonComment[] @relation("CommentReplies")

  @@index([lessonId])
  @@index([userId])
  @@index([parentId])
  @@map("lesson_comments")
}

model Quiz {
  id        String        @id @default(cuid())
  lessonId  String        @unique
  passScore Int           @default(70) // % mínimo para aprovação
  questions Json          // [{ pergunta, opcoes[], indiceCorreto }]
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts  QuizAttempt[]
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int      // % acertos
  passed    Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
}

// ══════════════════════════════════════════
// BDB POINTS — Fase 5.5 (estrutura)
// ══════════════════════════════════════════

enum PointTxType {
  GANHO
  RESGATE
  EXPIRACAO
  ESTORNO
  AJUSTE
}

model PointRule {
  id          String   @id @default(cuid())
  action      String   @unique
  label       String
  points      Int
  dailyCap    Int?
  monthlyCap  Int?
  countsToCap Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PointTransaction {
  id             String      @id @default(cuid())
  userId         String
  type           PointTxType
  amount         Int         // positivo para GANHO; NEGATIVO para RESGATE/EXPIRACAO/ESTORNO
  reason         String
  refType        String?
  refId          String?
  expiresAt      DateTime?   // preenchido apenas em GANHO (createdAt + 12 meses)
  reverted       Boolean     @default(false) // APENAS auditoria — não usar no cálculo
  idempotencyKey String?     @unique // ex.: "CRIAR_CONTA:userId", "ESTORNO:txId"
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, type])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  userId         String
  discountPct    Int
  appliesTo      String
  pointsCost     Int
  expiresAt      DateTime
  usedAt         DateTime?
  stripeCouponId String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RewardOption {
  id                 String  @id @default(cuid())
  label              String
  pointsCost         Int
  discountPct        Int
  appliesTo          String
  couponValidityDays Int     @default(15)
  active             Boolean @default(true)
  order              Int     @default(0)
}

enum BolaoStatus {
  ABERTO
  ENCERRADO
}

enum PalpiteOverUnder {
  OVER   // mais de 2.5 gols
  UNDER  // menos de 2.5 gols
}

model Bolao {
  id            String         @id @default(uuid())
  nome          String
  competitionId String         // ex: comp_6107
  seasonId      String         // ex: sn_118868
  status        BolaoStatus    @default(ABERTO)
  premiacao     Json?
  palpites      BolaoPalpite[]
  scores        BolaoScore[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("boloes")
}

model BolaoPalpite {
  id               String           @id @default(uuid())
  bolaoId          String
  userId           String
  matchId          String           // FK -> tabela matches existente

  golsMandante     Int
  golsVisitante    Int
  palpiteOverUnder PalpiteOverUnder // manual, independente do placar

  pontos           Int              @default(0)
  acertouPlacar    Boolean          @default(false)
  acertouResultado Boolean          @default(false)
  acertouOverUnder Boolean          @default(false)
  avaliado         Boolean          @default(false)

  lockedAt         DateTime         // utc_date - 1h, congelado na criação
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  bolao            Bolao            @relation(fields: [bolaoId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  match            Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([bolaoId, userId, matchId])
  @@index([matchId])
  @@index([bolaoId, userId])
  @@map("bolao_palpites")
}

model BolaoScore {
  id                 String   @id @default(uuid())
  bolaoId            String
  userId             String
  pontosTotal        Float    @default(0) // Mudado para Float para média simples
  quantidadePalpites Int      @default(0) // Quantidade de palpites avaliados
  acertosPlacar      Int      @default(0)
  acertosResultado   Int      @default(0)
  acertosOverUnder   Int      @default(0)
  updatedAt          DateTime @updatedAt

  bolao            Bolao    @relation(fields: [bolaoId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bolaoId, userId])
  @@index([bolaoId, pontosTotal, quantidadePalpites, acertosPlacar, acertosResultado])
  @@map("bolao_scores")
}

model PlanConfig {
  id            String   @id @default(cuid())
  name          String   @unique
  priceCents    Int      // ex: 3990 para R$ 39,90
  stripePriceId String
  description   String?  @db.Text
  features      String   @db.Text // JSON string list of features: ["feature 1", "feature 2"]
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("plan_configs")
}

// ============================================
// Fase 5 — Tabelas para o motor de Backtest
// ============================================

model LeagueSnapshot {
  id            String   @id @default(cuid())
  competitionId String
  seasonId      String
  matchId       String   @unique
  utcDate       DateTime

  // Parâmetros estatísticos e de modelagem acumulados na temporada até a data da partida
  muH           Float    // Média gols mandante
  muA           Float    // Média gols visitante
  varH          Float    // Variância gols mandante
  varA          Float    // Variância gols visitante
  piH           Float    // Excesso de zeros mandante (ZIP)
  piA           Float    // Excesso de zeros visitante (ZIP)
  rho           Float    // Parâmetro Dixon-Coles (global da temporada)
  totalJogos    Int      // Total de jogos na amostra da temporada
  muH_xg        Float?   // Média xG mandante
  muA_xg        Float?   // Média xG visitante

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  season        Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  match         Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([competitionId, seasonId, utcDate])
  @@map("league_snapshots")
}

model MatchTeamStats {
  id                String   @id @default(cuid())
  matchId           String
  teamId            String
  side              Side     // HOME | AWAY
  window            Int?     // 5 | 10 | 20 | 40 | null = Total/Temporada

  // Estatísticas computadas no corte temporal
  avgGoalsScored    Float?
  avgGoalsConceded  Float?
  cvGoals           Float?   // Coeficiente de variação dos gols
  avgCorners        Float?
  avgShots          Float?
  avgShotsOnTarget  Float?
  xg                Float?
  passAccuracy      Float?

  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamId, window])
  @@index([side, window])
  @@map("match_team_stats")
}

enum Side {
  HOME
  AWAY
}

model SavedBacktest {
  id         String   @id @default(cuid())
  userId     String
  name       String
  filters    Json     // Payload de filtros Zod
  resultMeta Json     // Resultados resumidos (ROI, hits, etc.)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_backtests")
}



