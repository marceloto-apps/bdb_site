# Banco de dados
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# NextAuth
NEXTAUTH_SECRET="gerar-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Brevo
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="contato@bigdatabet.com.br"
BREVO_SENDER_NAME="Big Data Bet"

# Posthog
NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST não é mais usado pelo client (reverse proxy)
# Mantido apenas como referência/fallback se necessário no servidor
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Seed
SEED_ADMIN_PASSWORD=""

# URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================
# FASE 2 — Motor Analítico
# ============================

# API-Football (api-sports.io)
# Criar conta em: https://dashboard.api-football.com/
# Plano free: 100 requests/dia
API_FOOTBALL_KEY=your_api_football_key_here

# Liga padrão (ID do Brasileirão na API-Football)
# 71 = Brasileirão Série A
API_FOOTBALL_LEAGUE_ID=71

# ============================
# FASE 4 — Stripe & Pagamentos
# ============================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PRICE_VIP_BASICO=""
NEXT_PUBLIC_STRIPE_PRICE_VIP_PRO=""

# Backtest Livre — leitura do dataset no Cloudflare R2 (token SOMENTE LEITURA restrito ao bucket)
R2_ACCOUNT_ID=
R2_BUCKET=bdb-laboratorio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
